# Proposal form (src/app/api/proposal/route.ts)
# Copy to .env.local for local dev, and set the same variables on Vercel.
# With Gmail: SMTP_USER is your address and SMTP_PASS is an App Password
# (Google account > Security > 2-Step Verification > App passwords).
SMTP_USER=
SMTP_PASS=
# Optional (defaults shown)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
PROPOSAL_TO=raharimanana99@gmail.com
